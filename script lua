                holdShuriken(toy)
                task.wait(0.3)

                -- ④ ターゲットの後ろにテレポート
                if not teleportBehindTarget() then
                    task.wait(0.3)
                    continue
                end
                task.wait(0.15)

                -- ⑤ ターゲットに刺す
                stickShuriken(toy)
                task.wait(0.5)

                -- ⑥ もう一度刺す（確実に）
                stickShuriken(toy)
                task.wait(0.4)
            end
        end

        local function startLoopShuriken()
            if loopShurikenActive then return end
            loopShurikenActive = true
            loopShurikenTask = task.spawn(loopShuriken)
