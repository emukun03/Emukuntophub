        local function runGucci()
            gucciN += 1
            local myRun = gucciN
            local v24, seat, v25, v26 = nil, nil, nil, nil
            local conn3 = nil
            local respawnedRecently = false
            local function cleanup()
                if conn3 then conn3:Disconnect() conn3 = nil end
                if v24 then dt(v24) v24 = nil end
                seat = nil v25 = nil v26 = nil
            end
            gucciCleanup = cleanup
            local function hide(arg)
                if arg:IsA("BasePart") then
                    arg.Transparency = 1
                    arg.CanCollide = false
                elseif arg:IsA("Decal") or arg:IsA("Texture") then
                    arg.Transparency = 1
                elseif arg.Name == "ItemSpawnSound" then
                    arg:Destroy()
                end
            end
            local function ride(v27, v28, rd, gType)
                if not v24 or not seat then return false end
                local v29, v30, v31 = v24, seat, v25
                local flag3 = true
                if v31 then
                    local bp = v31:FindFirstChild("GucciBP")
                    if bp then bp:Destroy() end
                end
                v30.Transparency = 1
                v30.CanCollide = false
                local flag5 = false
                local cFrame = v27.CFrame
                local now = tick()
                v30.ChildAdded:Once(function(child)
                    if child.Name == "SeatWeld" then
                        child.Enabled = false
                        child:Destroy()
