do
    local dkEnabled = false
    local dkTask = nil
    local dkAngle = 0
    local dkRadius = 25
    local dkSpeed = 29
    local dkBlob = nil
    local function GetSeatedBlob()
        local char = LocalPlayer.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return nil end
        local seat = hum.SeatPart
        if not seat or not seat:IsA("VehicleSeat") then return nil end
        local o = seat
        while o do
            if o:IsA("Model") and o.Name == "CreatureBlobman" then return o end
            o = o.Parent
        end
        return nil
    end
    local function SpawnBlob()
        local char = LocalPlayer.Character
        if not char then return nil end
        local rp = char:FindFirstChild("HumanoidRootPart")
        if not rp then return nil end
        local ex = GetSeatedBlob()
        if ex then dkBlob = ex return ex end
        local sp = rp.CFrame * CFrame.new(0, 0, -5)
        pcall(function()
            ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer("CreatureBlobman", sp, Vector3.new(0, 127, 0))
        end)
        local fn = LocalPlayer.Name .. "SpawnedInToys"
        local blob = nil
        local st = tick()
        repeat
            local f = Workspace:FindFirstChild(fn)
            if f then blob = f:FindFirstChild("CreatureBlobman") end
            if blob then break end
            task.wait(0.1)
        until tick() - st > 3
        if not blob then return nil end
        local seat = blob:FindFirstChild("VehicleSeat")
        if seat then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then seat:Sit(hum) task.wait(0.1) end
        end
        dkBlob = blob
        return blob
    end
    local function StartDK()
        if dkEnabled then return end
        local tp = SharedTarget.Player
        if not tp then Toggles.DriftKickToggle:SetValue(false) return end
        dkEnabled = true
        dkAngle = 0
        local blob = SpawnBlob()
        if not blob then Toggles.DriftKickToggle:SetValue(false) dkEnabled = false return end
        dkTask = task.spawn(function()
            local GE2 = ReplicatedStorage:WaitForChild("GrabEvents")
            local blobRoot = blob:FindFirstChild("HumanoidRootPart") or blob.PrimaryPart
            local so = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
            local CG = so and so:FindFirstChild("CreatureGrab")
            local CD = so and so:FindFirstChild("CreatureDrop")
            local RD = blob:FindFirstChild("RightDetector")
            local savedPos = blobRoot.CFrame
            while dkEnabled do
                local tRoot = tp.Character and tp.Character:FindFirstChild("HumanoidRootPart")
                local tHum = tp.Character and tp.Character:FindFirstChild("Humanoid")
                if tRoot and tHum and tHum.Health > 0 and blobRoot then
                    local lockPos = savedPos * CFrame.new(0, 23, 0)
                    tRoot.CFrame = lockPos
                    tRoot.Velocity = Vector3.zero
                    dkAngle = dkAngle + (RunService.Heartbeat:Wait() * dkSpeed)
                    local ox = math.cos(dkAngle) * dkRadius
                    local oz = math.sin(dkAngle) * dkRadius
                    local ocf = lockPos * CFrame.new(ox, 0, oz)
                    blobRoot.CFrame = CFrame.lookAt(ocf.Position, lockPos.Position)
                    pcall(function()
                        tHum.PlatformStand = true
                        tHum.Sit = true
                        GE2.SetNetworkOwner:FireServer(tRoot, lockPos)
                        if RD then
                            local w = RD:FindFirstChild("RightWeld") or RD:FindFirstChildWhichIsA("Weld")
                            if w then CD:FireServer(w) end
                        end
                        GE2.DestroyGrabLine:FireServer(tRoot)
                        if CG and RD then CG:FireServer(RD, tRoot, RD.RightWeld) end
                    end)
                end
            end
        end)
    end
    local function StopDK()
        dkEnabled = false
        if dkTask then task.cancel(dkTask) dkTask = nil end
        if dkBlob and dkBlob.Parent then dkBlob:Destroy() end
        dkBlob = nil
    end
    KickGroup:AddToggle("DriftKickToggle", { Text = "Drift Kick", Default = false,
        Callback = function(v) if v then StartDK() else StopDK() end end })
end

