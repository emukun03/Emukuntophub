    end
    local function AntiToyClearToys()
        task.spawn(function()
            for _ = 1, 5 do
                local inv = AntiToyGetFolder()
                if inv then
                    for _, v in pairs(inv:GetChildren()) do
                        local n = v.Name
                        if AntiToyConfig[n] or n == "AntiKick" or n == "Noclipped" then
                            pcall(function() dt(v) end)
                        end
                    end
                end
                task.wait(0.05)
            end
        end)
    end
    local function AntiToyGetAttachPart(char)
        local cfg2 = AntiToyConfig[AntiToySelected]
        if not cfg2 then return nil end
        if cfg2.AttachTo == "FirePlayerPart" then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return nil end
            return hrp:FindFirstChild("FirePlayerPart") or hrp:WaitForChild("FirePlayerPart", 3)
        end
        return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    end
    local function AntiToySpawn()
        local toyName = AntiToySelected
        local cfg2 = AntiToyConfig[toyName]
        if not toyName or not cfg2 then return nil end
        local hrp = AntiToyGetHRP()
        if not hrp then return nil end
        local canSpawn = LocalPlayer:FindFirstChild("CanSpawnToy")
        local w = 0
        while canSpawn and not canSpawn.Value and w < 30 do
            task.wait(0.1)
            w = w + 1
        end
        local inv = AntiToyGetFolder()
        if not inv then return nil end
        local spawned = nil
        local conn
        conn = inv.ChildAdded:Connect(function(c)
            if c.Name == toyName then spawned = c end
        end)
        task.spawn(function()
            pcall(function()
                fireRemote(_t23.spawnEvent, toyName, hrp.CFrame * CFrame.new(0, 2, 3), Vector3.zero)
            end)
        end)
        local t0 = tick()
        repeat task.wait(0.05) until spawned or (tick() - t0) > 1.5
        if conn then pcall(function() conn:Disconnect() end) end
        if not spawned and inv then
            spawned = inv:FindFirstChild(toyName)
        end
        if spawned then return spawned end
        return nil
    end
    local function AntiToyStick(toy)
        if not toy or not toy:FindFirstChild("StickyPart") then return false end
        local cfg2 = AntiToyConfig[AntiToySelected]
        if not cfg2 then return false end
        local char = LocalPlayer.Character
        if not char then return false end
        local attachPart = AntiToyGetAttachPart(char)
        if not attachPart then return false end
        local sticky = toy:FindFirstChild("StickyPart")
        local soundPart = toy:FindFirstChild("SoundPart")
        if soundPart then
            if not soundPart:FindFirstChild("PartOwner") or soundPart.PartOwner.Value ~= LocalPlayer.Name then
                pcall(function() setNetworkOwner:FireServer(soundPart, soundPart.CFrame) end)
            end
        end
        if _t23.spe then
            pcall(function()
                _t23.spe:FireServer(sticky, attachPart, cfg2.Offset)
            end)
        end
        for _, obj in pairs(toy:GetChildren()) do
            if obj:IsA("BasePart") then
                obj.CanTouch = false
                obj.CanCollide = false
                obj.CanQuery = false
            end
        end
        if cfg2.Rename then toy.Name = cfg2.Rename end
        return true
    end
    local function AntiToyIsWelded(toy)
        if not toy then return false end
        local sticky = toy:FindFirstChild("StickyPart")
        if not sticky then return false end
        local weld = sticky:FindFirstChild("StickyWeld")
        return weld and weld.Part1 ~= nil
    end
    local function AntiToyFindCurrent()
        local inv = AntiToyGetFolder()
        if not inv then return nil end
        local cfg2 = AntiToyConfig[AntiToySelected]
        local toy = inv:FindFirstChild(AntiToySelected)
        if not toy and cfg2 and cfg2.Rename then
            toy = inv:FindFirstChild(cfg2.Rename)
        end
        if not toy then toy = inv:FindFirstChild("AntiKick") end
        return toy
    end
    local function AntiToyLoop()
        while AntiToyActive do
            task.wait(0.15)
            local char = LocalPlayer.Character
            if not char then continue end
            local hum = char:FindFirstChild("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local toy = AntiToyFindCurrent()
            if not toy then
                toy = AntiToySpawn()
                if toy then
                    task.wait(0.1)
                    AntiToyStick(toy)
                end
            else
                if not AntiToyIsWelded(toy) then AntiToyStick(toy) end
                local sticky = toy:FindFirstChild("StickyPart")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if sticky and hrp then
                    if (hrp.Position - sticky.Position).Magnitude >= 25 then
                        pcall(function() dt(toy) end)
                    end
                end
            end
        end
        AntiToyClearToys()
    end
    function StartAntiToy()
        if AntiToyActive then return end
        AntiToyActive = true
        AntiToyLoopTask = task.spawn(AntiToyLoop)
        notify("Anti Kick v2", "ON (" .. AntiToySelected .. ")", 2)
    end
    function StopAntiToy()
        AntiToyActive = false
        if AntiToyLoopTask then
            pcall(function() task.cancel(AntiToyLoopTask) end)
            AntiToyLoopTask = nil
        end
        AntiToyClearToys()
        notify("Anti Kick v2", "OFF", 2)
    end
    function SetAntiToyType(toyName)
        local wasOn = AntiToyActive
        if wasOn then StopAntiToy() end
        AntiToySelected = toyName
        if wasOn then StartAntiToy() end
    end
    _G.StartAntiToy = StartAntiToy
    _G.StopAntiToy = StopAntiToy

