do
    local Section = Tabs.Player:AddRightGroupbox("Teleport", "target")
    local loopTeleportActive = false
    local loopTeleportTask = nil
    Section:AddButton({ Text = "Teleport",
        Func = function()
            local target = SharedTarget.Player
            if not target then notify("Teleport", "Target を選択してください", 3) return end
            local _, myRoot = getCharInfo()
            local tRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
            if not myRoot or not tRoot then return end
            pcall(function()
                myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, -3)
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
            end)
        end })
    Section:AddToggle("LoopTeleportToggle", { Text = "Loop Teleport", Default = false,
        Callback = function(Value)
            loopTeleportActive = Value
            if Value then
                if not SharedTarget.Player then Toggles.LoopTeleportToggle:SetValue(false) loopTeleportActive = false return end
                loopTeleportTask = task.spawn(function()
                    while loopTeleportActive do
                        local target = SharedTarget.Player
                        if target and target.Parent and target.Character then
                            local _, myRoot = getCharInfo()
                            local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
                            if myRoot and tRoot then
                                pcall(function()
                                    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, -3)
                                    myRoot.AssemblyLinearVelocity = Vector3.zero
                                    myRoot.AssemblyAngularVelocity = Vector3.zero
                                end)
                            end
                        end
                        task.wait(0.05)
                    end
                end)
            elseif loopTeleportTask then
                task.cancel(loopTeleportTask)
                loopTeleportTask = nil
            end
        end })
end

