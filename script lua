                for _, c in pairs(f:GetChildren()) do
                    if c.Name == "NinjaShuriken" or c.Name == "NinjaKunai" or c.Name == "AntiKick" then
                        pcall(function() destroyToy(c) end)
                    end
                end
            end
            notify("Loop Shuriken", "停止", 2)
        end

        ToySelectGroup:AddToggle("LoopShurikenToggle", {
            Text = "Loop Shuriken",
            Default = false,
            Tooltip = "手裏剣を自動でスポーン→掴む→ターゲットの後ろにテレポート→刺すを繰り返す",
            Callback = function(v)
                if v then
                    if not SharedTarget.Player then
                        Toggles.LoopShurikenToggle:SetValue(false)
                        notify("Loop Shuriken", "ターゲットを選択してください", 3)
