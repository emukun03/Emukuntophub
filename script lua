        local function applyPaintPart(part, on)
            if not part:IsA("BasePart") or part.Name ~= "PaintPlayerPart" then return end
            part.CanTouch = not on
            if on and not paintConn[part] then
                paintConn[part] = part:GetPropertyChangedSignal("CanTouch"):Connect(function()
                    if togglesRef.AntiPaint and part.Parent then part.CanTouch = false end
                end)
            end
        end
        function ApplyAntiPaint(on)
            for k, v in pairs(paintConn) do
                v:Disconnect() paintConn[k] = nil
                if k.Parent then k.CanTouch = true end
