    local LastGrabbed = Misc:AddLabel("LastGrabbedLabel_T", {
        Text = "Last person who grabbed you: nil", DoesWrap = true
    })
    task.spawn(function()
        local prev = nil
        while task.wait(0.05) do
            if state.WhoGrabbed ~= prev then
                if LastGrabbed.SetText then
                    LastGrabbed:SetText("Last person who grabbed you: " .. tostring(state.WhoGrabbed))
                end
                prev = state.WhoGrabbed
            end
        end
    end)

    local CA = DT:AddRightGroupbox("Counter-attack", "swords")
    CA:AddDropdown("CADropdown_T", {
        Values = { "Kill", "Grab", "Fling", "Teleport to Spawn" },
        Default = "Kill", Multi = false, Text = "Consequences",
        Callback = function(c) cfg.CounterMethod = c end,
    })
    CA:AddToggle("CAToggle_T", { Text = "Counter Attack", Default = false,
        Callback = function(v) togglesRef.CounterAttack = v end })

    local Config = DT:AddRightGroupbox("Config", "settings")
    Config:AddSlider("AntiLagSens_T", {
        Text = "Auto Anti-Lag Sensitivity", Default = 3, Min = 1, Max = 20, Prefix = "FPS",
        Callback = function(v) cfg.AntiLagSens = v end })
    Config:AddDivider("Anti-Grabs")
    Config:AddDropdown("AGTDropdown_T", {
        Values = { "Normal", "No Ragdoll", "Anti-Kill", "Escapes Anything, but buggy" },
        Default = 1, Multi = false, Text = "Anti-Grab Type",
        Callback = function(v) cfg.AGType = v end,
    })
    Config:AddDropdown("GTDropdown_T", {
        Values = { "Blobman", "Tractor [Invisible]", "Train [Invisible]", "Sleigh [Invisible]" },
        Default = 1, Multi = false, Text = "GUCCI Type",
        Callback = function(arg)
            if arg == "Blobman" then cfg.GucciType = "CreatureBlobman"
            elseif arg == "Tractor [Invisible]" then cfg.GucciType = "TractorGreen"
            elseif arg == "Train [Invisible]" then cfg.GucciType = "Train"
            elseif arg == "Sleigh [Invisible]" then cfg.GucciType = "SantaSleigh" end
        end,
    })
    Config:AddDivider("Anti Net-Owner")
    Config:AddDropdown("AITDropdown_T", {
        Values = {
            "InstrumentGuitarBanjo", "FoodHamburger", "InstrumentDrumBongos",
            "InstrumentBrassTrumpet", "InstrumentBrassBugle", "InstrumentVoiceMicrophone",
            "InstrumentWoodwindOcarina", "InstrumentGuitarUkulele", "InstrumentGuitarLyre",
            "InstrumentGuitarAcoustic", "CupMugBrown", "CupMugWhite",
            "FoodBanana", "FoodBread", "FoodBroccoli", "FoodCakePink",
            "FoodCoconut", "FoodDippyEgg", "FoodDonut", "FoodFrenchFries", "FoodHotdog",
            "FoodMayonnaise", "FoodMeatStick", "FoodMushroomPoison", "FoodPizzaCheese",
            "FoodPizzaPepperoni", "FoodSodaCan", "PoopPile", "PoopPileSparkle",
        },
        Default = 1, Multi = false, Text = "Type",
        Callback = function(v) cfg.AntiInputType = v end,
    })
    Config:AddSlider("AntiInpLagDel_T", {
        Text = "Grab & Drop Delay", Default = 0.05, Min = 0, Max = 0.3, Prefix = "sec",
        Rounding = 2, Callback = function(v) cfg.InputLgDelay = v end })
    Config:AddLabel("Below 0.05 can cause high ping")
    Config:AddSlider("ItemTransAK_T", {
        Text = "Item Transparency (0 = 見える)", Default = cfg.AILTransparency, Min = 0, Max = 1,
        Rounding = 2, Callback = function(v) cfg.AILTransparency = v end })

    ApplyDisableVoid(true)

    -- ============================================================
    --  ★ 起動時自動 ON
    -- ============================================================
    task.spawn(function()
        task.wait(0.5)

        togglesRef.AntiLag = true
        ApplyAntiLag(true)
        if Toggles.AntiLag_T then Toggles.AntiLag_T:SetValue(true) end

        togglesRef.AntiLagV2 = true
        ApplyAntiLagV2(true)
        if Toggles.AntiLagV2_T then Toggles.AntiLagV2_T:SetValue(true) end

        togglesRef.AntiKick = true
        if _G.HandleAntiKickShuriken then _G.HandleAntiKickShuriken(true) end
        if Toggles.AntiKick_T then Toggles.AntiKick_T:SetValue(true) end

        togglesRef.AntiInputLag = false
        if Toggles.AntiInputLag_T then Toggles.AntiInputLag_T:SetValue(false) end

        notify("System", "Anti Lag / Anti Lag v2 / Anti Kick 自動 ON", 5)
    end)
end

