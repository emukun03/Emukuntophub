                        flag6 = true
                        if _t23.RagdollRemote then fireRemote(_t23.RagdollRemote, v27, 0) end
                    end
                    flag6 = true
                end)
                while true do
                    task.wait()
                    if flag6 or myRun ~= gucciN then break end
                end
                if myRun ~= gucciN then return false end
                v30:Sit(v28)
                while true do
                    task.wait()
                    if v28.Health <= 0 or not v27.Parent or not v29.Parent or not v30.Parent then break end
                    if isHeld.Value or rd.Value or flag5 or tick() - now > 0.75 then break end
                end
                if flag5 then
