        local function loopPoop()
            while loopPoopActive do
                -- ターゲット確認
                if not SharedTarget.Player or not SharedTarget.Player.Character then
                    task.wait(0.5)
                    continue
                end

                -- ① 既存 Poop チェック
                local toy = findPoop()

                -- ② なければスポーン
                if not toy then
                    toy = spawnPoop()
                    if not toy then
                        task.wait(0.5)
                        continue
                    end
                end

                -- ③ ネット権限取得
                local sp = toy:FindFirstChild("SoundPart")
                if sp then setNO(sp) end

                -- ④ 持つ
                holdPoop(toy)
                task.wait(0.15)
                holdPoop(toy)
                task.wait(0.4)

                -- ⑤ 食べる
                usePoop(toy)

                -- ⑥ 食べ終わるまで待つ
                local t0 = tick()
                while loopPoopActive and toy and toy.Parent and isEating(toy) do
                    if tick() - t0 > 5 then break end
                    task.wait(0.1)
                end

                -- ⑦ 食べ終わったら即座にターゲットの後ろにテレポート
                if loopPoopActive then
                    teleportBehindTarget()
                    task.wait(0.2)
                end

                -- ⑧ クリーンアップ
                if toy and toy.Parent then
                    pcall(function() dropPoop(toy) end)
                    task.wait(0.05)
                    pcall(function() destroyToy(toy) end)
                end

                task.wait(0.3)
            end
        end

        local function startLoopPoop()
            if loopPoopActive then return end
            loopPoopActive = true
            loopPoopTask = task.spawn(loopPoop)
            notify("Loop Poop", "開始", 2)
        end

        local function stopLoopPoop()
            loopPoopActive = false
            if loopPoopTask then
                pcall(function() task.cancel(loopPoopTask) end)
                loopPoopTask = nil
            end
            local f = getFolder()
            if f then
