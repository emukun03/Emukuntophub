        local isHeld = LocalPlayer:WaitForChild("IsHeld", 5)
        local function findNicePart(model)
            if typeof(model) ~= "Instance" or not model:IsA("Model") then return nil end
            for _, c in pairs(model:GetChildren()) do
                if c:IsA("BasePart") and c.CanQuery and c.Name ~= "Button" then return c end
            end
