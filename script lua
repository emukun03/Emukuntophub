            elseif cfg.CounterMethod == "Grab" then
                if v24 then grab(v24) end
            elseif cfg.CounterMethod == "Fling" then
                if v24 and arg2 and sno(v24) then
                    v24.Velocity = arg2.CFrame.LookVector * 100 + Vector3.new(0, 25, 0)
                end
            elseif cfg.CounterMethod == "Teleport to Spawn" then
