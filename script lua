do
    local Section = Tabs.Player:AddLeftGroupbox("Fly", "star")
    local flyEnabled = false
    local flySpeed = 50
    Section:AddToggle("FlyToggle", { Text = "Fly", Default = false, Callback = function(v) flyEnabled = v end })
    Section:AddSlider("FlySpeedSlider", { Text = "Fly Speed", Default = 50, Min = 10, Max = 200, Rounding = 0, Callback = function(v) flySpeed = v end })
    RunService.RenderStepped:Connect(function()
        if flyEnabled and LocalPlayer.Character then
            local char = LocalPlayer.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum and root then
                local camera = Workspace.CurrentCamera
                local md = hum.MoveDirection
                if md.Magnitude > 0 then
                    local rd = root.CFrame:VectorToObjectSpace(md)
                    local fd = (camera.CFrame.LookVector * -rd.Z) + (camera.CFrame.RightVector * rd.X)
                    root.AssemblyLinearVelocity = fd * flySpeed
                else
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end
        end
    end)
end

