-- Blob Kick (Spam)
do
    local REMOTE_DELAY = 0.002
    local function BlobGrabKickHard(targetName)
        local GE = ReplicatedStorage:WaitForChild("GrabEvents")
        local lastRemote = 0
        task.spawn(function()
            local target = Players:FindFirstChild(targetName)
            if not target then return end
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local hum = char:WaitForChild("Humanoid")
            local seat = hum.SeatPart
            if not seat or seat.Parent.Name ~= "CreatureBlobman" then return end
            local blob = seat.Parent
            local blobRoot = blob:FindFirstChild("HumanoidRootPart") or blob.PrimaryPart
            local so = blob:WaitForChild("BlobmanSeatAndOwnerScript")
            local CG = so:WaitForChild("CreatureGrab")
            local CD = so:WaitForChild("CreatureDrop")
            local RD = blob:WaitForChild("RightDetector")
            local savedPos = blobRoot.CFrame
            local dragging = false
            local gst = 0
            while blobKickActive do
                local cur = Players:FindFirstChild(targetName)
                if not cur then break end
                char = LocalPlayer.Character
                hum = char and char:FindFirstChild("Humanoid")
                seat = hum and hum.SeatPart
                if not seat or seat.Parent.Name ~= "CreatureBlobman" then break end
                blob = seat.Parent
                blobRoot = blob:FindFirstChild("HumanoidRootPart") or blob.PrimaryPart
                local tChar = cur.Character
                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChild("Humanoid")
                if tRoot and tHum and tHum.Health > 0 and blobRoot then
                    tRoot.Velocity = Vector3.zero
                    if not dragging then
                        blobRoot.CFrame = tRoot.CFrame
                        blobRoot.Velocity = Vector3.zero
                        if tick() - lastRemote >= REMOTE_DELAY then
                            lastRemote = tick()
                            pcall(function()
                                tHum.PlatformStand = true
                                tHum.Sit = true
                                GE.SetNetworkOwner:FireServer(tRoot, blobRoot.CFrame)
                                GE.DestroyGrabLine:FireServer(tRoot)
                            end)
                        end
                        if gst == 0 then gst = tick() end
                        if tick() - gst > 0.35 then
                            dragging = true gst = 0
                            blobRoot.CFrame = savedPos
                            blobRoot.Velocity = Vector3.zero
                        end
                    else
                        blobRoot.CFrame = savedPos
                        blobRoot.Velocity = Vector3.zero
                        local lockPos = savedPos * CFrame.new(0, 20, 0)
                        tRoot.CFrame = lockPos
                        tHum.PlatformStand = true
                        tHum.Sit = true
                        if tick() - lastRemote >= REMOTE_DELAY then
                            lastRemote = tick()
                            pcall(function()
                                GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                                GE.DestroyGrabLine:FireServer(tRoot)
                                local w = RD:FindFirstChild("RightWeld") or RD:FindFirstChildWhichIsA("Weld")
                                if w then CD:FireServer(w) CG:FireServer(RD, tRoot, w) end
                            end)
                        end
                    end
                else dragging = false gst = 0 end
                RunService.Heartbeat:Wait()
            end
        end)
    end
    local function AutoSitLoop()
        while blobKickAutoSit do
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if not hrp or not hum then task.wait(1) continue end
            if hum.SeatPart then task.wait(0.5) continue end
            local fn = LocalPlayer.Name .. "SpawnedInToys"
            local folder = Workspace:FindFirstChild(fn)
            local blob = folder and folder:FindFirstChild("CreatureBlobman")
            if not blob then
                task.spawn(function()
                    pcall(function()
                        ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer("CreatureBlobman", hrp.CFrame, Vector3.zero)
                    end)
                end)
                if not folder then folder = Workspace:WaitForChild(fn, 5) end
                if folder then blob = folder:WaitForChild("CreatureBlobman", 5) end
            end
            if blob then
                local seat = blob:WaitForChild("VehicleSeat", 5)
                if seat then
                    local t = tick()
                    repeat
                        if not hum.SeatPart then
                            hrp.CFrame = seat.CFrame + Vector3.new(0, 1, 0)
                            hrp.Velocity = Vector3.zero
                            seat:Sit(hum)
                        end
                        RunService.Heartbeat:Wait()
                    until hum.SeatPart == seat or tick() - t > 1.5 or not blobKickAutoSit
                end
            end
            task.wait(0.5)
        end
    end
    local function StartSitWatcher()
        if blobKickAutoKickConnection then blobKickAutoKickConnection:Disconnect() blobKickAutoKickConnection = nil end
        blobKickAutoKickConnection = RunService.Heartbeat:Connect(function()
            if not blobKickAutoSit then return end
            if blobKickActive then return end
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChild("Humanoid")
            if not hum then return end
            local seat = hum.SeatPart
            if seat and seat.Parent and seat.Parent.Name == "CreatureBlobman" then
                local tn = SharedTarget.Username
                if tn and tn ~= "" then
                    blobKickActive = true
                    BlobGrabKickHard(tn)
                end
            end
        end)
    end
    KickGroup:AddToggle("BlobKickSpamToggle", { Text = "Blob Kick (Spam)", Default = false,
        Callback = function(Value)
            if Value then
                local tn = SharedTarget.Username
                if not tn or tn == "" then Toggles.BlobKickSpamToggle:SetValue(false) return end
                blobKickSelectedTarget = SharedTarget.Player
                if not blobKickSelectedTarget then Toggles.BlobKickSpamToggle:SetValue(false) return end
                blobKickAutoSit = true
                task.spawn(AutoSitLoop)
                StartSitWatcher()
            else
                blobKickAutoSit = false
                blobKickActive = false
                if blobKickAutoKickConnection then blobKickAutoKickConnection:Disconnect() blobKickAutoKickConnection = nil end
            end
        end })
end

-- Spam Grab Kick
do
    local spamKickEnabled = false
    local spamKickMainTask = nil
    local spamKickBodyPosition = nil
    local spamKickBodyGyro = nil
    local spamKickSavedPosition = nil
    local spamKickDragging = false
    local spamKickGrabStartTime = 0
    local spamKickNoclipConn = nil
    local GE = ReplicatedStorage:WaitForChild("GrabEvents", 10)
    local sNO = GE and GE:WaitForChild("SetNetworkOwner", 5)
    local dGL = GE and GE:WaitForChild("DestroyGrabLine", 5)
    local function SetNoclip(e)
        if spamKickNoclipConn then spamKickNoclipConn:Disconnect() spamKickNoclipConn = nil end
        if e then
            spamKickNoclipConn = RunService.Stepped:Connect(function()
                if LocalPlayer.Character then
                    for _, p in ipairs(LocalPlayer.Character:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
            end)
        end
    end
    local function CreateBodies(tr, pos)
        if spamKickBodyPosition then spamKickBodyPosition:Destroy() spamKickBodyPosition = nil end
        if spamKickBodyGyro then spamKickBodyGyro:Destroy() spamKickBodyGyro = nil end
        spamKickBodyPosition = Instance.new("BodyPosition")
        spamKickBodyPosition.MaxForce = Vector3.new(1e8, 1e8, 1e8)
        spamKickBodyPosition.P = 100000 spamKickBodyPosition.D = 1000
        spamKickBodyPosition.Position = pos
        spamKickBodyPosition.Parent = tr
        spamKickBodyGyro = Instance.new("BodyGyro")
        spamKickBodyGyro.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
        spamKickBodyGyro.P = 100000 spamKickBodyGyro.D = 1000
        spamKickBodyGyro.CFrame = CFrame.new(pos)
        spamKickBodyGyro.Parent = tr
    end
    local function CleanupBodies()
        if spamKickBodyPosition then spamKickBodyPosition:Destroy() spamKickBodyPosition = nil end
        if spamKickBodyGyro then spamKickBodyGyro:Destroy() spamKickBodyGyro = nil end
    end
    local function StopSpam()
        spamKickEnabled = false
        if spamKickMainTask then task.cancel(spamKickMainTask) spamKickMainTask = nil end
        CleanupBodies()
        SetNoclip(false)
    end
    local function StartSpam()
        if spamKickEnabled then return end
        local tn = SharedTarget.Username
        if not tn or tn == "" then Toggles.SpamGrabKickToggle:SetValue(false) return end
        local tp = SharedTarget.Player
        if not tp then Toggles.SpamGrabKickToggle:SetValue(false) return end
        spamKickEnabled = true
        SetNoclip(true)
        spamKickMainTask = task.spawn(function()
            local _, myRoot = getCharInfo()
            if not myRoot then StopSpam() return end
            spamKickSavedPosition = myRoot.CFrame
            while spamKickEnabled do
                local cur = Players:FindFirstChild(tp.Name)
                if not cur then CleanupBodies() task.wait() continue end
                local _, mr = getCharInfo()
                local tChar = cur.Character
                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChild("Humanoid")
                if tRoot and tHum and tHum.Health > 0 and mr then
                    if not spamKickDragging then
                        mr.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                        CleanupBodies()
                        if sNO then sNO:FireServer(tRoot, tRoot.CFrame) end
                        if sNO then sNO:FireServer(tRoot, tRoot.CFrame) end
                        if dGL then dGL:FireServer(tRoot) end
                        mr.AssemblyLinearVelocity = Vector3.zero
                        mr.AssemblyAngularVelocity = Vector3.zero
                        if spamKickGrabStartTime == 0 then spamKickGrabStartTime = tick() end
                        if tick() - spamKickGrabStartTime > 0.35 then
                            spamKickDragging = true
                            spamKickGrabStartTime = 0
                            local lockPos = spamKickSavedPosition * CFrame.new(0, 17, 0)
                            CreateBodies(tRoot, lockPos.Position)
                        end
                    else
                        mr.CFrame = spamKickSavedPosition
                        local lockPos = spamKickSavedPosition * CFrame.new(0, 17, 0)
                        if spamKickBodyPosition and spamKickBodyPosition.Parent then
                            spamKickBodyPosition.Position = lockPos.Position
                            if spamKickBodyGyro then spamKickBodyGyro.CFrame = lockPos end
                        else CreateBodies(tRoot, lockPos.Position) end
                    end
                else spamKickDragging = false spamKickGrabStartTime = 0 CleanupBodies() end
                task.wait()
            end
        end)
    end
    KickGroup:AddToggle("SpamGrabKickToggle", { Text = "Spam Grab Kick", Default = false,
        Callback = function(Value) if Value then StartSpam() else StopSpam() end end })
end

-- Grab Kick
do
    local grabkickEnabled = false
    local grabkickTargetName = ""
    local kunaiActive = false
    local kunaiThread = nil
    local KUNAI_NAMES = { "NinjaKunai", "NinjaShuriken", "AntiKick" }

    local packetLagRunning = false
    local packetLagThread = nil
    local SEND_PER_SECOND = 65
    local SEND_INTERVAL = 1 / SEND_PER_SECOND

    local function startPacketLag()
        if packetLagRunning then return end
        packetLagRunning = true
        packetLagThread = task.spawn(function()
            local GE = ReplicatedStorage:WaitForChild("GrabEvents")
            local createLine = GE:FindFirstChild("CreateGrabLine")
            local extendLine = GE:FindFirstChild("ExtendGrabLine")
            while packetLagRunning do
                local startTime = tick()
                local spawnLocation = Workspace:FindFirstChild("SpawnLocation")
                    or Workspace:FindFirstChild("Spawn")
                    or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
                if spawnLocation then
                    local rndCF = CFrame.new(
                        math.random(-2000000000, 2000000000),
                        0,
                        math.random(-2000000000, 2000000000)
                    )
                    pcall(function()
                        if createLine then createLine:FireServer(spawnLocation, rndCF) end
                        if extendLine then extendLine:FireServer(spawnLocation, rndCF) end
                    end)
                end
                local elapsed = tick() - startTime
                local waitTime = SEND_INTERVAL - elapsed
                if waitTime > 0 then task.wait(waitTime) end
            end
        end)
    end
    local function stopPacketLag()
        packetLagRunning = false
        if packetLagThread then
            task.cancel(packetLagThread)
            packetLagThread = nil
        end
    end

    local lineLagThread = nil
    local lineLagEnabled = false
    local LINE_SEND_PER_SECOND = 212
    local LINE_SEND_INTERVAL = 1 / LINE_SEND_PER_SECOND
    local function startLineLag()
        if lineLagThread then return end
        lineLagEnabled = true
        lineLagThread = task.spawn(function()
            local GE = ReplicatedStorage:WaitForChild("GrabEvents")
            local createLine = GE:FindFirstChild("CreateGrabLine")
            if not createLine then return end
            while lineLagEnabled do
                local startTime = tick()
                local spawnLocation = Workspace:FindFirstChild("SpawnLocation") or Workspace:FindFirstChild("Spawn")
                if not spawnLocation and LocalPlayer.Character then
                    spawnLocation = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                end
                if spawnLocation then
                    local rx = math.random(-1e9, 1e9)
                    local rz = math.random(-1e9, 1e9)
                    pcall(function()
                        createLine:FireServer(spawnLocation, CFrame.new(rx, 0, rz))
                    end)
                end
                local elapsed = tick() - startTime
                local waitTime = LINE_SEND_INTERVAL - elapsed
                if waitTime > 0 then task.wait(waitTime) end
            end
        end)
    end
    local function stopLineLag()
        lineLagEnabled = false
        if lineLagThread then
            task.cancel(lineLagThread)
            lineLagThread = nil
        end
    end

    local function startKunaiYeet()
        if kunaiActive then return end
        kunaiActive = true
        kunaiThread = task.spawn(function()
            while kunaiActive do
                local targetName = grabkickTargetName
                if targetName and targetName ~= "" then
                    local target = Players:FindFirstChild(targetName)
                    if target then
                        local folder = Workspace:FindFirstChild(target.Name .. "SpawnedInToys")
                        if folder then
                            for _, toyName in ipairs(KUNAI_NAMES) do
                                local toy = folder:FindFirstChild(toyName)
                                if toy then
                                    local part = toy:FindFirstChild("SoundPart")
                                    if part then
                                        pcall(function()
                                            setNetworkOwner:FireServer(part, part.CFrame)
                                        end)
                                        task.wait()
                                        local owner = part:FindFirstChild("PartOwner")
                                        if owner and owner.Value == LocalPlayer.Name then
                                            part.CFrame = CFrame.new(0, 1000, 0)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
    end
    local function stopKunaiYeet()
        kunaiActive = false
        if kunaiThread then
            task.cancel(kunaiThread)
            kunaiThread = nil
        end
    end

    local function approachTarget(targetPlayer, myRoot)
        if not targetPlayer.Character then return end
        local tRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not tRoot or not myRoot then return end
        local saved = myRoot.CFrame
        myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2)
        for i = 1, 15 do
            setNetworkOwner:FireServer(tRoot, tRoot.CFrame)
            task.wait()
        end
        myRoot.CFrame = saved
    end

    KickGroup:AddToggle("GrabKickToggle", {
        Text = "Grab Kick",
        Default = false,
        Tooltip = "ターゲットを13m上に固定 + Line Lag + Packet Lag + Kunai Yeet / OFF: 停止",
        Callback = function(on)
            grabkickEnabled = on
            if on then
                local targetName = SharedTarget.Username
                if not targetName or targetName == "" then
                    notify("Grab Kick", "Select target first", 3)
                    Toggles.GrabKickToggle:SetValue(false)
                    grabkickEnabled = false
                    return
                end
                grabkickTargetName = targetName
                startLineLag()
                startPacketLag()
                startKunaiYeet()
                notify("Grab Kick", "開始: " .. targetName, 3)
            else
                stopLineLag()
                stopPacketLag()
                stopKunaiYeet()
                notify("Grab Kick", "停止", 3)
            end

            if on then
                task.spawn(function()
                    while grabkickEnabled do
                        local targetPlayer = Players:FindFirstChild(grabkickTargetName)
                        local myChar, myRoot = getCharInfo()
                        if targetPlayer and myRoot then
                            local tChar = targetPlayer.Character
                            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                            if tRoot then
                                local dist = (myRoot.Position - tRoot.Position).Magnitude
                                if dist > 25 then
                                    approachTarget(targetPlayer, myRoot)
                                end
                                setNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                                if destroyGrabLine then
                                    destroyGrabLine:FireServer(tRoot)
                                end
                                tRoot.AssemblyLinearVelocity = Vector3.zero
                                tRoot.AssemblyAngularVelocity = Vector3.zero
                                local bp = tRoot:FindFirstChild("ControlBP")
                                if not bp then
                                    bp = Instance.new("BodyPosition")
                                    bp.Name = "ControlBP"
                                    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                    bp.P = 800000
                                    bp.Parent = tRoot
                                end
                                bp.Position = myRoot.Position + Vector3.new(0, 13, 0)
                            end
                        end
                        task.wait()
                    end
                    local targetPlayer = Players:FindFirstChild(grabkickTargetName)
