-- Blob Kill
do
    local currentBlobman = nil
    local function GetSeatedBlobman()
        local char = LocalPlayer.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return nil end
        local seat = hum.SeatPart
        if not seat or not seat:IsA("VehicleSeat") then return nil end
        local obj = seat
        while obj do
            if obj:IsA("Model") and obj.Name == "CreatureBlobman" then return obj end
            obj = obj.Parent
        end
        return nil
    end
    local function SpawnBlobman()
        local s = GetSeatedBlobman()
        if s then currentBlobman = s return s end
        if currentBlobman and currentBlobman.Parent then
            local pos
            if currentBlobman.PrimaryPart then pos = currentBlobman.PrimaryPart.Position
            else
                local p = currentBlobman:FindFirstChildWhichIsA("BasePart")
                if p then pos = p.Position end
            end
            local char = LocalPlayer.Character
            local rp = char and char:FindFirstChild("HumanoidRootPart")
            local lp = rp and rp.Position
            if pos and lp and (pos - lp).Magnitude < 500 then
                local seat = currentBlobman:FindFirstChild("VehicleSeat")
                if seat then
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum then seat:Sit(hum) task.wait(0.1) end
                end
                return currentBlobman
            else
                pcall(function() currentBlobman:Destroy() end)
                currentBlobman = nil
            end
        end
        local char = LocalPlayer.Character
        if not char then return nil end
        local rp = char:FindFirstChild("HumanoidRootPart")
        if not rp then return nil end
        local sp = rp.CFrame * CFrame.new(0, 0, -5)
        pcall(function()
            ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer("CreatureBlobman", sp, Vector3.new(0, 127, 0))
        end)
        local folderName = LocalPlayer.Name .. "SpawnedInToys"
        local blobman = nil
        local st = tick()
        repeat
            local folder = Workspace:FindFirstChild(folderName)
            if folder then blobman = folder:FindFirstChild("CreatureBlobman") end
            if blobman then break end
            task.wait()
        until tick() - st > 3
        if not blobman then return nil end
        currentBlobman = blobman
        local seat = blobman:FindFirstChild("VehicleSeat")
        if seat then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then seat:Sit(hum) task.wait(0.1) end
        end
        return blobman
    end
    local function BGR(bm, tr)
        if not bm or not tr then return end
        pcall(function()
            local s = bm:FindFirstChild("BlobmanSeatAndOwnerScript")
            if s then
                s.CreatureGrab:FireServer(bm.LeftDetector, tr, bm.LeftDetector.LeftWeld)
                s.CreatureRelease:FireServer(bm.LeftDetector.LeftWeld)
            end
        end)
    end
    local function Process(tp)
        if not tp or not tp.Character then return false end
        local hum = tp.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        local tRoot = tp.Character:FindFirstChild("HumanoidRootPart")
        if not tRoot then return false end
        local lc = LocalPlayer.Character
        if not lc then return false end
        local myRoot = lc:FindFirstChild("HumanoidRootPart")
        if not myRoot then return false end
        local bm = GetSeatedBlobman() or SpawnBlobman()
        if not bm then return false end
        local ocf, ov, oa = myRoot.CFrame, myRoot.AssemblyLinearVelocity, myRoot.AssemblyAngularVelocity
        pcall(function()
            myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, -3)
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
        end)
        task.wait(0.05)
        pcall(function() BGR(bm, tRoot) end)
        task.wait(0.02)
        pcall(function()
            hum.BreakJointsOnDeath = false
            hum:ChangeState(Enum.HumanoidStateType.Dead)
        end)
        pcall(function() BGR(bm, tRoot) end)
        if myRoot and myRoot.Parent then
            myRoot.CFrame = ocf
            myRoot.AssemblyLinearVelocity = ov or Vector3.zero
            myRoot.AssemblyAngularVelocity = oa or Vector3.zero
        end
        return true
    end
    KillGroup:AddToggle("BlobKillToggle", { Text = "Blob Kill", Default = false,
        Callback = function(on)
            blobKillEnabled = on
            if on then
                local target = SharedTarget.Player
                if not target then Toggles.BlobKillToggle:SetValue(false) return end
                task.spawn(function()
                    while blobKillEnabled do
                        if not target or not target.Parent or not target.Character then
                            blobKillEnabled = false Toggles.BlobKillToggle:SetValue(false) break
                        end
                        pcall(Process, target)
                        task.wait(0.1)
                    end
                end)
            else blobKillEnabled = false end
        end })
end

