            if Enabled then task.defer(function() setup(char) end) end
        end)
        function StartAntiGrabNRD()
            Enabled = true
            if LocalPlayer.Character then task.defer(function() setup(LocalPlayer.Character) end) end
        end
        function StopAntiGrabNRD()
            Enabled = false
            Proc = false
            Walk = false
        end
    end

