    -- Auto Reset
    do
        local conn = nil
        local function onFlag(arg)
            if arg ~= "Flying" then return end
            local now = tick()
            if now - state.LastKickFlagTime <= 1 then
                state.KickFlags = state.KickFlags + 1
            else
                state.LastKickFlagTime = now
                state.KickFlags = 1
            end
            if not togglesRef.AutoReset then return end
            if state.KickFlags < 4 then
                local _, _, v24 = charp()
                if v24 then
                    pcall(function()
                        v24:ChangeState(Enum.HumanoidStateType.Running)
                        v24:ChangeState(Enum.HumanoidStateType.Dead)
                    end)
                    if state.KickFlags == 1 then notify("Auto Reset", "Reset due to kick flag", 3) end
                end
            else
                LocalPlayer:Kick("Emukunhub (Auto Reset)\nAvoided Kick")
            end
        end
        local function bind()
            refreshRemotes()
            local gc = _v21 and _v21:FindFirstChild("GameCorrectionEvents")
            gc = gc and gc:FindFirstChild("GameCorrectionsNotify")
            if not gc or not gc:IsA("RemoteEvent") then return false end
            if conn then conn:Disconnect() end
            conn = gc.OnClientEvent:Connect(onFlag)
            return true
        end
        if not bind() then
            task.spawn(function()
                while task.wait(0.5) do
                    if bind() then break end
                end
            end)
