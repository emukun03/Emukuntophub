                    if typeof(v) == "Instance" and v:IsA("GuiObject") then frame = v break end
                end
            end
            tabFrames[name] = frame
        end
        local lastActive = nil
        while true do
            task.wait(0.1)
            local active = nil
            for name, f in pairs(tabFrames) do
                if f and f.Visible == true then active = name break end
            end
            if not active then
                for name, _ in pairs(Tabs) do
                    local obj = MainFrame:FindFirstChild(name, true)
                    if obj and obj:IsA("GuiObject") and obj.Visible == true then active = name break end
