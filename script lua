                    task.delay(0.15, function()
                        flag3 = false
                        task.wait()
                        if _t23.RagdollRemote and v27.Parent then
                            fireRemote(_t23.RagdollRemote, v27, 0.15)
                        end
                    end)
                    if respawnedRecently then teleport(v27, cFrame) end
