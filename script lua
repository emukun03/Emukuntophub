    local isDead = false
    local function getFolder() return Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys") end
    local function setNO(part)
        if not part then return end
        local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
        if not GE then return end
        local sN = GE:FindFirstChild("SetNetworkOwner")
        if not sN then return end
        pcall(function() sN:FireServer(part, part.CFrame) end)
    end
    local function destroyGL(part)
        if not part then return end
        local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
        if not GE then return end
        local dL = GE:FindFirstChild("DestroyGrabLine")
        if not dL then return end
        pcall(function() dL:FireServer(part) end)
    end
    local function destroyBanana(b)
        if not b then return end
        local MT = ReplicatedStorage:FindFirstChild("MenuToys")
        if not MT then return end
        local dT = MT:FindFirstChild("DestroyToy")
        if not dT then return end
        pcall(function() dT:FireServer(b) end)
    end
    local function spawnBanana()
        local _, myRoot = getCharInfo()
        if not myRoot then return nil end
        local sp = myRoot.CFrame * CFrame.new(0, 14, 20)
        local MT = ReplicatedStorage:FindFirstChild("MenuToys")
        if not MT then return nil end
        local sr = MT:FindFirstChild("SpawnToyRemoteFunction")
        if not sr then return nil end
        local spawned = nil
        local folder = getFolder()
        if not folder then return nil end
        local conn = folder.ChildAdded:Connect(function(child)
            if child.Name == "FoodBanana" then spawned = child conn:Disconnect() end
        end)
        task.spawn(function() pcall(function() sr:InvokeServer("FoodBanana", sp, Vector3.zero) end) end)
        local st = tick()
        repeat task.wait(0.05) until spawned or (tick() - st) > 3
        if conn then pcall(function() conn:Disconnect() end) end
        return spawned
    end
    local function holdBanana(b)
        if not b then return end
        local hp = b:FindFirstChild("HoldPart")
        if not hp then return end
        local hr = hp:FindFirstChild("HoldItemRemoteFunction")
        if not hr then return end
        local c = LocalPlayer.Character
        if not c then return end
        for i = 1, 5 do
            if not b or not b.Parent then break end
            local ok = pcall(function() return hr:InvokeServer(b, c) end)
            if ok then return true end
            task.wait(0.05)
        end
        return false
    end
    local function useBanana(b)
        if not b then return end
        local ue = ReplicatedStorage:FindFirstChild("HoldEvents") and ReplicatedStorage.HoldEvents:FindFirstChild("Use")
        if not ue then return end
        pcall(function() ue:FireServer(b) end)
    end
    local function dropBanana(b)
        if not b then return end
        local hp = b:FindFirstChild("HoldPart")
        if not hp then return end
        local dr = hp:FindFirstChild("DropItemRemoteFunction")
        if not dr then return end
        local _, myRoot = getCharInfo()
        if not myRoot then return end
        local dp = myRoot.CFrame * CFrame.new(0, 15, 0)
        pcall(function() dr:InvokeServer(b, dp, dp) end)
    end
    local function getLeg()
        local target = SharedTarget.Player
        if not target then return nil end
        if not target.Character then return nil end
        return target.Character:FindFirstChild("Left Leg")
    end
    local function getHealth()
        local target = SharedTarget.Player
        if not target then return 0 end
        if not target.Character then return 0 end
        local h = target.Character:FindFirstChildOfClass("Humanoid")
        if not h then return 0 end
        return h.Health
    end
    local function cycle()
        if not SharedTarget.Player then return false end
        local b = spawnBanana()
        if not b then return false end
        holdBanana(b) task.wait(0.05) holdBanana(b) task.wait(0.05)
        task.wait(0.5)
        useBanana(b)
        task.wait(2.3)
        dropBanana(b) task.wait(0.05) dropBanana(b)
        task.wait(0.3)
        return b
    end
    local function restart(b)
        if loopConn then loopConn:Disconnect() loopConn = nil end
        curBanana = b
        local hb = b:FindFirstChild("HitboxPart")
        if not hb then return end
        loopConn = RunService.Heartbeat:Connect(function()
            if not isLooping then return end
            if not curBanana or not curBanana.Parent then return end
            local folder = getFolder()
            local exists = false
            if folder then
                for _, c in pairs(folder:GetChildren()) do
                    if c.Name == "FoodBanana" then
                        exists = true
                        curBanana = c
                        hb = c:FindFirstChild("HitboxPart")
                        break
                    end
                end
            end
            if not exists or not hb then
                loopConn:Disconnect() loopConn = nil curBanana = nil
                return
            end
            local _, myRoot = getCharInfo()
            if not myRoot then return end
            local tp, tcf
            local h = getHealth()
            if h <= 0 then
                isDead = true
                tp = myRoot.CFrame * CFrame.new(0, 7, 0)
                tcf = CFrame.new(tp.Position)
            else
                isDead = false
                local l = getLeg()
                if l then tp = l.CFrame * CFrame.new(0, 0.5, 0) tcf = l.CFrame
                else tp = myRoot.CFrame * CFrame.new(0, 7, 0) tcf = CFrame.new(tp.Position) end
            end
            setNO(hb)
            destroyGL(hb)
            local bp = hb:FindFirstChild("BodyPosition")
            if bp then bp.Position = tp.Position
            else
                bp = Instance.new("BodyPosition")
                bp.P = 10000 bp.D = 100
                bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                bp.Position = tp.Position
                bp.Parent = hb
            end
            local bg = hb:FindFirstChild("BodyGyro")
            if bg then bg.CFrame = tcf
            else
                bg = Instance.new("BodyGyro")
                bg.P = 10000 bg.D = 100
                bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                bg.CFrame = tcf
                bg.Parent = hb
            end
        end)
    end
    local function start()
        if isLooping then return end
        if not SharedTarget.Player then return end
        isLooping = true
        isDead = false
        local b = cycle()
        if b then restart(b) end
        monitorConn = RunService.Heartbeat:Connect(function()
            if not isLooping then return end
            local folder = getFolder()
            local exists = false
            if folder then
                for _, c in pairs(folder:GetChildren()) do
                    if c.Name == "FoodBanana" then exists = true break end
                end
            end
            if not exists then
                if loopConn then loopConn:Disconnect() loopConn = nil end
                task.wait(0.05)
                local nb = cycle()
                if nb then restart(nb) end
            end
        end)
    end
    local function stop()
        isLooping = false
        if loopConn then loopConn:Disconnect() loopConn = nil end
        if monitorConn then monitorConn:Disconnect() monitorConn = nil end
        if curBanana then
            destroyBanana(curBanana)
            local hb = curBanana:FindFirstChild("HitboxPart")
            if hb then
                local bp = hb:FindFirstChild("BodyPosition")
                if bp then bp:Destroy() end
                local bg = hb:FindFirstChild("BodyGyro")
                if bg then bg:Destroy() end
            end
            curBanana = nil
        end
        local folder = getFolder()
        if folder then
            for _, c in pairs(folder:GetChildren()) do
                if c.Name == "FoodBanana" then destroyBanana(c) end
            end
        end
    end
    KillGroup:AddToggle("LoopBananaRagdollToggle", { Text = "Loop Banana Ragdoll", Default = false,
        Callback = function(v)
            if v then
                if not SharedTarget.Player then Toggles.LoopBananaRagdollToggle:SetValue(false) return end
                loopBananaRagdollEnabled = true
                stop()
                start()
            else
                loopBananaRagdollEnabled = false
                stop()
            end
        end })
end

