-- ============================================================
do
    local ToySelectGroup = Tabs.Target:AddLeftGroupbox("Toy Select", "package")

    -- ============================================================
    --  Loop Poop
    -- ============================================================
    do
        local loopPoopActive = false
        local loopPoopTask = nil

        local function getFolder() return Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys") end
        local function getHRP()
            local c = LocalPlayer.Character
            return c and c:FindFirstChild("HumanoidRootPart")
        end

        local function destroyToy(toy)
            if not toy then return end
            local MT = ReplicatedStorage:FindFirstChild("MenuToys")
            local dT = MT and MT:FindFirstChild("DestroyToy")
            if dT then pcall(function() dT:FireServer(toy) end) end
        end

        local function setNO(part)
            if not part then return end
            local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
            local sN = GE and GE:FindFirstChild("SetNetworkOwner")
            if sN then pcall(function() sN:FireServer(part, part.CFrame) end) end
        end

        local function findPoop()
            local f = getFolder()
            if not f then return nil end
            return f:FindFirstChild("PoopPile") or f:FindFirstChild("PoopPileSparkle")
        end

        local function spawnPoop()
            local hrp = getHRP()
            if not hrp then return nil end
            local MT = ReplicatedStorage:FindFirstChild("MenuToys")
            local sr = MT and MT:FindFirstChild("SpawnToyRemoteFunction")
            if not sr then return nil end
            local folder = getFolder()
            if not folder then return nil end

            local spawned = nil
            local conn
            conn = folder.ChildAdded:Connect(function(c)
                if c.Name == "PoopPile" or c.Name == "PoopPileSparkle" then
                    spawned = c
                end
            end)
            task.spawn(function()
                pcall(function()
                    sr:InvokeServer("PoopPile", hrp.CFrame * CFrame.new(0, 2, 3), Vector3.zero)
                end)
            end)
            local t0 = tick()
            repeat task.wait(0.05) until spawned or (tick() - t0) > 2
            if conn then pcall(function() conn:Disconnect() end) end
            if not spawned and folder then
                spawned = folder:FindFirstChild("PoopPile") or folder:FindFirstChild("PoopPileSparkle")
            end
            return spawned
        end

        local function holdPoop(toy)
            if not toy then return false end
            local hp = toy:FindFirstChild("HoldPart")
            if not hp then return false end
            local hr = hp:FindFirstChild("HoldItemRemoteFunction")
            if not hr then return false end
            local c = LocalPlayer.Character
            if not c then return false end
            for i = 1, 5 do
                if not toy or not toy.Parent then break end
                local ok = pcall(function() return hr:InvokeServer(toy, c) end)
                if ok then return true end
                task.wait(0.05)
            end
            return false
        end

        local function usePoop(toy)
            if not toy then return end
            local ue = ReplicatedStorage:FindFirstChild("HoldEvents")
            ue = ue and ue:FindFirstChild("Use")
            if ue then pcall(function() ue:FireServer(toy) end) end
        end

        local function dropPoop(toy)
            if not toy then return end
            local hp = toy:FindFirstChild("HoldPart")
            if not hp then return end
            local dr = hp:FindFirstChild("DropItemRemoteFunction")
            if not dr then return end
            local hrp = getHRP()
            if not hrp then return end
            local dp = hrp.CFrame * CFrame.new(0, 15, 0)
            pcall(function() dr:InvokeServer(toy, dp, dp) end)
        end

        local function isEating(toy)
            if not toy or not toy.Parent then return false end
            local hp = toy:FindFirstChild("HoldPart")
            if not hp then return false end
            -- HoldPart がまだ存在するなら食べ中
            return hp.Parent ~= nil
        end

        local function teleportBehindTarget()
            local target = SharedTarget.Player
            if not target or not target.Character then return false end
            local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
            local hrp = getHRP()
            if not tRoot or not hrp then return false end
            pcall(function()
                hrp.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
