            end
        end
        local function bind(char)
            local _, v23 = charp()
            char = char and char:FindFirstChild("Head")
            if not char then return end
            if conn then conn:Disconnect() end
            conn = char.ChildAdded:Connect(function(child)
                onChild(child, v23)
            end)
