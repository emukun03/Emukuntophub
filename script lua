        local Walk = false
        local StruggleR, RagdollR
        local function FWC(P, N, T) return P:FindFirstChild(N) or P:WaitForChild(N, T or 3) end
        local function setup(char)
            if not Enabled then return end
            local hrp = FWC(char, "HumanoidRootPart", 5)
            local hum = FWC(char, "Humanoid", 5)
            local head = FWC(char, "Head", 5)
            if not hrp or not hum or not head then return end
            head.ChildAdded:Connect(function(PO)
                if not Enabled then return end
                if PO and PO.Name == "PartOwner" then
                    if not Proc then
                        Proc = true
                        pcall(function() hum.Sit = false end)
                        pcall(function() if StruggleR then StruggleR:FireServer(LocalPlayer) end end)
                        task.spawn(function()
                            while Enabled and (head and head:FindFirstChild("PartOwner")) do
                                pcall(function() if StruggleR then StruggleR:FireServer(LocalPlayer) end end)
                                pcall(function() if RagdollR then RagdollR:FireServer(hrp, 0) end end)
                                task.wait()
                            end
                        end)
                        pcall(function() hrp.Anchored = true end)
                        if not Walk then
                            Walk = true
                            while Enabled and task.wait() do
                                local ih = LocalPlayer:FindFirstChild("IsHeld")
                                if not ih or not ih.Value then break end
                                pcall(function()
                                    if hum and hum.MoveDirection then
