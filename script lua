                return true
            end
        end
        return false
    end
    local rkActive = false
    local rkMonitor = nil
    local function RkMonitor()
        while rkActive do
            local n = countPencils()
            if n == 0 then doSticky()
            elseif n >= 2 then destroyPencils() task.wait(0.05) doSticky()
            elseif n == 1 then
                if not isWelded() then destroyPencils() task.wait(0.05) doSticky() end
            end
            task.wait(0.1)
